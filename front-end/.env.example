# Front-end environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Supabase project URL (Supabase Dashboard > Settings > API > Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Supabase Dashboard > Settings > API > anon key)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# JEDA backend REST API base URL
# Android emulator → 10.0.2.2 maps to host machine localhost
# iOS simulator   → localhost or 127.0.0.1
# Physical device → your machine's LAN IP (e.g. http://192.168.1.x:8080)
# Production      → https://your-backend-domain.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
